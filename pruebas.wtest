import elTorneo.*

describe"pelea potente"{
    test "pelea amv- goku vs vegeta"{
        const trajeGoku= new trajeComun(porcentajeDeDanio=0)
        const trajeVegeta= new trajeComun(porcentajeDeDanio=0)
        const goku =  new Guerrero(potencialOfensivo=100,energiaOriginal=5000,energia=5000,traje=trajeGoku)
        const vegeta = new Guerrero(potencialOfensivo = 100,energiaOriginal = 5000,energia = 5000,traje=trajeVegeta)

        goku.atacar(vegeta) 

        assert.equals(4990, vegeta.energia()) 
        assert.equals(1, vegeta.experiencia())



    }

    test "vegeta recibe un ataque con traje comun con proteccion al 0.03"{
        const trajeGoku = new trajeComun(porcentajeDeDanio=0)
        const trajeVegeta = new trajeComun(porcentajeDeDanio=0.03)

        const goku =  new Guerrero(potencialOfensivo=100,energiaOriginal=5000,energia=5000,traje=trajeGoku)
        const vegeta = new Guerrero(potencialOfensivo = 100,energiaOriginal = 5000,energia = 5000,traje=trajeVegeta)

        goku.atacar(vegeta)
        
        
        assert.equals(4993, vegeta.energia())

    }
    test "vegeta recibe un ataque con traje modularizado de dos piezas" {
        const goku = new Guerrero(potencialOfensivo = 100,energiaOriginal = 5000,energia = 5000,experiencia = 0,traje = new trajeDeEntrenamiento())
        const pieza1 = new Pieza(porcentajeResistencia = 1)
        const pieza2 = new Pieza(porcentajeResistencia = 4)
        const trajeVegeta = new trajeModularizados()
        trajeVegeta.piezas().add(pieza1)
        trajeVegeta.piezas().add(pieza2)

        const vegeta = new Guerrero(potencialOfensivo = 100,energiaOriginal = 5000,energia = 5000,experiencia = 0,traje = trajeVegeta)
        goku.atacar(vegeta)
        assert.equals(4995, vegeta.energia())
    }
}

